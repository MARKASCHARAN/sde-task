{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bill-splitter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bill-splitter",
      "database_id": "35faa680-006f-4e9b-b70c-22f15cf41813",
      "migrations_dir": "migrations"
    }
  ]
}
